# SDRAM profile, 100 MHz, CL3, U32 W9825G6KH-6. Generated by mkprofile.py from the routed board at 8cbbd79.
# Holds only with the matching RTL: see README.md. Above 100 MHz or after rerouting, rerun; do not edit numbers.
create_clock -period 20.000 -name sys_clk [get_ports SYS_CLK]
# X4 C717684: no datasheet in the repository. 200 ps peak to peak is an assumption, not a measured figure.
set_input_jitter sys_clk 0.200
# The phase comes from the MMCM output driving fwd/C; this line states no waveform of its own.
create_generated_clock -name sdram_clk -source [get_pins fwd/C] -divide_by 1 [get_ports SDRAM_CLK]
# Bus 8 mA slow, registers in the IOBs. SDRAM_CLK keeps 12 mA fast from ref/freya.xdc and runs through R151.
set_property DRIVE 8 [get_ports {SDRAM_A0 SDRAM_A1 SDRAM_A2 SDRAM_A3 SDRAM_A4 SDRAM_A5 SDRAM_A6 SDRAM_A7 SDRAM_A8 SDRAM_A9 SDRAM_A10 SDRAM_A11 SDRAM_A12 SDRAM_BA0 SDRAM_BA1 SDRAM_CS_N SDRAM_RAS_N SDRAM_CAS_N SDRAM_WE_N SDRAM_CKE SDRAM_LDQM SDRAM_UDQM SDRAM_DQ0 SDRAM_DQ1 SDRAM_DQ2 SDRAM_DQ3 SDRAM_DQ4 SDRAM_DQ5 SDRAM_DQ6 SDRAM_DQ7 SDRAM_DQ8 SDRAM_DQ9 SDRAM_DQ10 SDRAM_DQ11 SDRAM_DQ12 SDRAM_DQ13 SDRAM_DQ14 SDRAM_DQ15}]
set_property SLEW SLOW [get_ports {SDRAM_A0 SDRAM_A1 SDRAM_A2 SDRAM_A3 SDRAM_A4 SDRAM_A5 SDRAM_A6 SDRAM_A7 SDRAM_A8 SDRAM_A9 SDRAM_A10 SDRAM_A11 SDRAM_A12 SDRAM_BA0 SDRAM_BA1 SDRAM_CS_N SDRAM_RAS_N SDRAM_CAS_N SDRAM_WE_N SDRAM_CKE SDRAM_LDQM SDRAM_UDQM SDRAM_DQ0 SDRAM_DQ1 SDRAM_DQ2 SDRAM_DQ3 SDRAM_DQ4 SDRAM_DQ5 SDRAM_DQ6 SDRAM_DQ7 SDRAM_DQ8 SDRAM_DQ9 SDRAM_DQ10 SDRAM_DQ11 SDRAM_DQ12 SDRAM_DQ13 SDRAM_DQ14 SDRAM_DQ15}]
set_property IOB TRUE [get_ports {SDRAM_A0 SDRAM_A1 SDRAM_A2 SDRAM_A3 SDRAM_A4 SDRAM_A5 SDRAM_A6 SDRAM_A7 SDRAM_A8 SDRAM_A9 SDRAM_A10 SDRAM_A11 SDRAM_A12 SDRAM_BA0 SDRAM_BA1 SDRAM_CS_N SDRAM_RAS_N SDRAM_CAS_N SDRAM_WE_N SDRAM_CKE SDRAM_LDQM SDRAM_UDQM SDRAM_DQ0 SDRAM_DQ1 SDRAM_DQ2 SDRAM_DQ3 SDRAM_DQ4 SDRAM_DQ5 SDRAM_DQ6 SDRAM_DQ7 SDRAM_DQ8 SDRAM_DQ9 SDRAM_DQ10 SDRAM_DQ11 SDRAM_DQ12 SDRAM_DQ13 SDRAM_DQ14 SDRAM_DQ15}]
# output delay: max = tS + settle - clock flight min; min = -tH + leave - clock flight max.
# input delay: max = clock flight max + tAC + DQ delay max + allowance; min = clock flight min + tOH + DQ delay min - allowance.
set_output_delay -clock sdram_clk -max 2.618 [get_ports SDRAM_A0]
set_output_delay -clock sdram_clk -min -0.995 [get_ports SDRAM_A0]
set_output_delay -clock sdram_clk -max 2.764 [get_ports SDRAM_A1]
set_output_delay -clock sdram_clk -min -0.922 [get_ports SDRAM_A1]
