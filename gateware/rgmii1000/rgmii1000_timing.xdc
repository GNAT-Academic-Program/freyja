# RGMII profile, 125 MHz DDR, U30 RTL8211FDI-CG, TXDLY = 1, RXDLY = 1. Generated by mkprofile.py.
# Holds only with the matching RTL: see README.md. After rerouting, rerun; do not edit numbers.
create_clock -period 20.000 -name sys_clk [get_ports SYS_CLK]
# X4 C717684: no datasheet in the repository. 200 ps peak to peak is an assumption, as in sdram100.
set_input_jitter sys_clk 0.200
set_property DRIVE 8 [get_ports {PHY_TXC PHY_TXD0 PHY_TXD1 PHY_TXD2 PHY_TXD3 PHY_TX_CTL}]
set_property SLEW FAST [get_ports {PHY_TXC PHY_TXD0 PHY_TXD1 PHY_TXD2 PHY_TXD3 PHY_TX_CTL}]
# TX: skew-based, edge-aligned at the FPGA, both TXC edges. Data launched on a TXC edge must reach U30 within
# TskewT of that same edge. The half-cycle setup relation exists only to express the limit: setup slack = TskewT - skew.
create_generated_clock -name txc -source [get_pins txc_oddr/C] -divide_by 1 [get_ports PHY_TXC]
set_output_delay -clock txc -max 3.511 [get_ports PHY_TXD0]
set_output_delay -clock txc -min 0.439 [get_ports PHY_TXD0]
set_output_delay -clock txc -clock_fall -max 3.511 [get_ports PHY_TXD0] -add_delay
set_output_delay -clock txc -clock_fall -min 0.439 [get_ports PHY_TXD0] -add_delay
set_output_delay -clock txc -max 3.552 [get_ports PHY_TXD1]
set_output_delay -clock txc -min 0.488 [get_ports PHY_TXD1]
set_output_delay -clock txc -clock_fall -max 3.552 [get_ports PHY_TXD1] -add_delay
set_output_delay -clock txc -clock_fall -min 0.488 [get_ports PHY_TXD1] -add_delay
set_output_delay -clock txc -max 3.498 [get_ports PHY_TXD2]
set_output_delay -clock txc -min 0.422 [get_ports PHY_TXD2]
set_output_delay -clock txc -clock_fall -max 3.498 [get_ports PHY_TXD2] -add_delay
set_output_delay -clock txc -clock_fall -min 0.422 [get_ports PHY_TXD2] -add_delay
set_output_delay -clock txc -max 3.532 [get_ports PHY_TXD3]
set_output_delay -clock txc -min 0.462 [get_ports PHY_TXD3]
set_output_delay -clock txc -clock_fall -max 3.532 [get_ports PHY_TXD3] -add_delay
set_output_delay -clock txc -clock_fall -min 0.462 [get_ports PHY_TXD3] -add_delay
set_output_delay -clock txc -max 3.498 [get_ports PHY_TX_CTL]
set_output_delay -clock txc -min 0.432 [get_ports PHY_TX_CTL]
set_output_delay -clock txc -clock_fall -max 3.498 [get_ports PHY_TX_CTL] -add_delay
set_output_delay -clock txc -clock_fall -min 0.432 [get_ports PHY_TX_CTL] -add_delay
# RX: the received clock only. Data launched by one RXC edge is valid TholdT after it and TsetupT before the next,
# at U30. max = T/2 - TsetupT + (data - clock) high; min = TholdT + (data - clock) low. No jitter term: Table 60 gives none.
create_clock -period 8.000 -name phy_rxc [get_ports PHY_RXC]
set_input_delay -clock phy_rxc -max 2.904 [get_ports PHY_RXD0]
set_input_delay -clock phy_rxc -min 1.101 [get_ports PHY_RXD0]
set_input_delay -clock phy_rxc -clock_fall -max 2.904 [get_ports PHY_RXD0] -add_delay
set_input_delay -clock phy_rxc -clock_fall -min 1.101 [get_ports PHY_RXD0] -add_delay
set_input_delay -clock phy_rxc -max 2.825 [get_ports PHY_RXD1]
set_input_delay -clock phy_rxc -min 1.022 [get_ports PHY_RXD1]
set_input_delay -clock phy_rxc -clock_fall -max 2.825 [get_ports PHY_RXD1] -add_delay
set_input_delay -clock phy_rxc -clock_fall -min 1.022 [get_ports PHY_RXD1] -add_delay
set_input_delay -clock phy_rxc -max 2.946 [get_ports PHY_RXD2]
set_input_delay -clock phy_rxc -min 1.141 [get_ports PHY_RXD2]
set_input_delay -clock phy_rxc -clock_fall -max 2.946 [get_ports PHY_RXD2] -add_delay
set_input_delay -clock phy_rxc -clock_fall -min 1.141 [get_ports PHY_RXD2] -add_delay
set_input_delay -clock phy_rxc -max 2.943 [get_ports PHY_RXD3]
set_input_delay -clock phy_rxc -min 1.135 [get_ports PHY_RXD3]
set_input_delay -clock phy_rxc -clock_fall -max 2.943 [get_ports PHY_RXD3] -add_delay
set_input_delay -clock phy_rxc -clock_fall -min 1.135 [get_ports PHY_RXD3] -add_delay
set_input_delay -clock phy_rxc -max 2.836 [get_ports PHY_RX_CTL]
set_input_delay -clock phy_rxc -min 1.031 [get_ports PHY_RX_CTL]
set_input_delay -clock phy_rxc -clock_fall -max 2.836 [get_ports PHY_RX_CTL] -add_delay
set_input_delay -clock phy_rxc -clock_fall -min 1.031 [get_ports PHY_RX_CTL] -add_delay
# The two clocks share no reference on the board. The fixture has no path between them.
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks sys_clk] -group phy_rxc
