# Generated by tools/gen_pcb.py; see ref/pcb-impedance.md.
(version 1)
(rule "Default clearance"
  (constraint clearance (min 0.15mm)))
(rule "PSRAM minimum width"
  (condition "A.hasNetclass('PSRAM')")
  (constraint track_width (min 0.1mm) (opt 0.1mm)))
(rule "AUX_RAIL 5A aggregate"
  (condition "A.hasNetclass('AUX_5A')")
  (constraint track_width (min 2.0mm) (opt 2.0mm)))
(rule "input path 3A"
  (condition "A.hasNetclass('PWR_3A')")
  (constraint track_width (min 1.5mm) (opt 1.5mm)))
(rule "extension buses 2A"
  (condition "A.hasNetclass('EXT_2A')")
  (constraint track_width (min 1.0mm) (opt 1.0mm)))
# U11's output sense: a +5V_BUCK track on F.Cu wholly inside the U11_SENSE rule area, the
# 0.5 mm strip from C189.1 under U11 to R55.1, may be 0.2 mm. It carries the divider's
# 40 uA. Every other +5V_BUCK track keeps "input path 3A". Later rules win, so this follows it.
(rule "U11 output sense branch"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == '+5V_BUCK' && A.enclosedByArea('U11_SENSE')")
  (constraint track_width (min 0.2mm) (opt 0.2mm)))
# U34's input pins: a +5V_BUCK or VBUS track on F.Cu wholly inside U34_NECK_IN2 or
# U34_NECK_IN1, the pin's own neck, may be 0.5 mm: the 0.40 mm pin has another net 0.30 mm
# away on both sides, so the class width cannot reach it. Everything beyond the neck keeps "input path 3A".
(rule "U34 input pin necks"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && (A.NetName == '+5V_BUCK' || A.NetName == 'VBUS') && (A.enclosedByArea('U34_NECK_IN2') || A.enclosedByArea('U34_NECK_IN1'))")
  (constraint track_width (min 0.5mm) (opt 0.5mm)))
# U34's VBUS divider taps (R162.1, R164.1, 50 uA each): VBUS tracks wholly inside U34_VBUS_TAPS (F.Cu) or
# U34_VBUS_TAPS_IN2 (In2) may be 0.25 mm. The areas hold nothing but the taps.
(rule "U34 VBUS divider taps"
  (condition "A.Type == 'Track' && A.NetName == 'VBUS' && (A.enclosedByArea('U34_VBUS_TAPS') || A.enclosedByArea('U34_VBUS_TAPS_IN2'))")
  (constraint track_width (min 0.25mm) (opt 0.25mm)))
# Q7's gate divider reads VIN_EXT through R201 (100k, 0.2 mA at 21 V): a VIN_EXT track wholly inside VIN_EXT_TAP,
# the 0.5 mm strip along that one route, may be 0.2 mm. The input path from J50 keeps "input path 3A".
(rule "VIN_EXT tap to Q7's divider"
  (condition "A.Type == 'Track' && A.NetName == 'VIN_EXT' && A.enclosedByArea('VIN_EXT_TAP')")
  (constraint track_width (min 0.2mm) (opt 0.2mm)))
# J1's VBUS pad pairs: a VBUS track on F.Cu wholly inside J1_VBUS_NECK_W or J1_VBUS_NECK_E may be 0.6 mm,
# the 0.60 mm pad's own neck into the 1.5 mm copper below it (GND 0.20 mm and a CC pad 0.25 mm beside the pad).
(rule "J1 VBUS pin necks"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'VBUS' && (A.enclosedByArea('J1_VBUS_NECK_W') || A.enclosedByArea('J1_VBUS_NECK_E'))")
  (constraint track_width (min 0.6mm) (opt 0.6mm)))
# U18's VIN pin (0.28 x 0.67 mm, 0.5 mm pitch): a VBUS track on F.Cu wholly inside U18_VIN_NECK may be 0.28 mm.
(rule "U18 VIN pin neck"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'VBUS' && A.enclosedByArea('U18_VIN_NECK')")
  (constraint track_width (min 0.28mm) (opt 0.28mm)))
# U26's IN pins 9 and 10 (0.28 x 0.67 mm, 0.5 mm pitch, OUT pin 8 beside pin 9): a VBUS track on F.Cu wholly inside
# U26_IN_NECKS may be 0.28 mm. Pins 11 to 13 are covered by the 1.5 mm bar.
(rule "U26 IN pin necks"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'VBUS' && A.enclosedByArea('U26_IN_NECKS')")
  (constraint track_width (min 0.28mm) (opt 0.28mm)))
# U26's OUT pins 7 and 8 (north face): a VBUS_SS track on F.Cu wholly inside U26_OUT_NECKS may be 0.28 mm.
(rule "U26 OUT pin necks"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'VBUS_SS' && A.enclosedByArea('U26_OUT_NECKS')")
  (constraint track_width (min 0.28mm) (opt 0.28mm)))
# R50 (110k) reads VBUS for U26's UVLO and OVP thresholds, 33 uA: a VBUS track on F.Cu wholly inside U26_VBUS_TAP may be 0.2 mm.
(rule "U26 VBUS divider tap"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'VBUS' && A.enclosedByArea('U26_VBUS_TAP')")
  (constraint track_width (min 0.2mm) (opt 0.2mm)))
# R81 (100k) reads VSYS for the controller's monitor, 80 uA: a VSYS track wholly inside VSYS_MON_TAP (F.Cu and In2) may be 0.2 mm.
(rule "VSYS monitor tap"
  (condition "A.Type == 'Track' && A.NetName == 'VSYS' && A.enclosedByArea('VSYS_MON_TAP')")
  (constraint track_width (min 0.2mm) (opt 0.2mm)))
# RGMII: about 50 ohm on all four signal layers. Timing is set by the derived
# delay limits in gateware/rgmii1000, not by equal lengths. The U30 side of each
# TX resistor is in this class too.
(rule "RGMII width"
  (condition "A.hasNetclass('RGMII')")
  (constraint track_width (min 0.125mm) (opt 0.125mm)))
# SDRAM: 0.125 mm is about 50 ohm on all four signal layers (48.4 outer, 49.1
# inner, field solve). Target 100 MHz, CL3. Equal lengths are not required: use
# the derived delay limits in ref/pcb-impedance.md. Above 100 MHz, reassess.
(rule "SDRAM width"
  (condition "A.hasNetclass('SDRAM')")
  (constraint track_width (min 0.125mm) (opt 0.125mm)))
# 100 ohm differential pairs: the LVDS_25 link pairs and the PHY's MDI pairs.
# Geometry is calculated only for L1 over In1 and B.Cu over In6.
(rule "100R outer geometry"
  (layer outer)
  (condition "A.hasNetclass('LVDS_100R') || A.hasNetclass('MDI_100R')")
  (constraint track_width (min 0.099mm) (opt 0.099mm) (max 0.099mm))
  (constraint diff_pair_gap (min 0.2mm) (opt 0.2mm) (max 0.2mm)))
(rule "100R outer routing only"
  (layer inner)
  (condition "A.hasNetclass('LVDS_100R') || A.hasNetclass('MDI_100R')")
  (constraint disallow track))
# Keep other copper >= ~4 dielectric heights away from the pair tracks for
# the non-coplanar model. Pads are not held to it as the first item, but a pair
# track is held to it against any pad.
(rule "100R clearance to other copper"
  (condition "A.Type == 'Track' && (A.hasNetclass('LVDS_100R') || A.hasNetclass('MDI_100R')) && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.31mm)))
# J73 pad entry: at 0.5 mm pitch a 0.099 mm track on a pad centre is 0.3005 mm
# from the next pad, so 0.31 mm cannot be met, and P and N run 1.0 mm apart
# with a GND pad between, so the gap is 0.901 mm. HDMI TMDS tracks wholly inside the
# J73_TMDS_ENTRY rule area only. These must follow the rules above.
(rule "HDMI TMDS entry to J73 pads"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && (A.NetName == 'HDMI_CLK_*' || A.NetName == 'HDMI_D0_*' || A.NetName == 'HDMI_D1_*' || A.NetName == 'HDMI_D2_*') && A.enclosedByArea('J73_TMDS_ENTRY') && B.Type == 'Pad' && B.memberOfFootprint('J73') && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.3mm)))
(rule "HDMI TMDS entry pair gap at J73"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && (A.NetName == 'HDMI_CLK_*' || A.NetName == 'HDMI_D0_*' || A.NetName == 'HDMI_D1_*' || A.NetName == 'HDMI_D2_*') && A.enclosedByArea('J73_TMDS_ENTRY')")
  (constraint diff_pair_gap (min 0.2mm) (opt 0.2mm) (max 0.901mm)))
# J71/J72 contact entries: a 0.099 mm track between 1.524 mm contacts on 2.04 mm pitch has
# 0.2085 mm a side. LINK tracks wholly inside J71_LINK_ENTRY or J72_LINK_ENTRY, against those jacks' pads only.
(rule "LINK entry to J71 J72 pads"
  (layer outer)
  (condition "A.Type == 'Track' && A.NetName == 'LINK_*' && (A.enclosedByArea('J71_LINK_ENTRY') || A.enclosedByArea('J72_LINK_ENTRY')) && B.Type == 'Pad' && (B.memberOfFootprint('J71') || B.memberOfFootprint('J72')) && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.2mm)))
# U30 MDI launch: on a 0.4 mm pitch pad centre a 0.099 mm track is 0.2505 mm from the next
# pad, and one lane has about 0.17 mm at a pad corner. MDI tracks wholly inside U30_MDI_LAUNCH, against U30 pads only.
(rule "MDI launch to U30 pads"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'ETH_MDI*' && A.enclosedByArea('U30_MDI_LAUNCH') && B.Type == 'Pad' && B.memberOfFootprint('U30') && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.17mm)))
# MDI to another MDI pair in U30_MDI_LAUNCH, tracks and vias: not between coupled partners, which keep the 0.200 mm gap.
(rule "MDI launch to other MDI pairs"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'ETH_MDI*' && A.enclosedByArea('U30_MDI_LAUNCH') && (B.Type == 'Track' || B.Type == 'Via') && B.NetName == 'ETH_MDI*' && !AB.isCoupledDiffPair()")
  (constraint clearance (min 0.16mm)))
# PHY_1V0 exits of U30 pins 3 and 8 between MDI tracks in U30_MDI_LAUNCH: both tracks wholly inside it. A PHY_1V0 via keeps 0.31 mm.
(rule "MDI launch to PHY_1V0 exits"
  (layer "F.Cu")
  (condition "A.Type == 'Track' && A.NetName == 'ETH_MDI*' && A.enclosedByArea('U30_MDI_LAUNCH') && B.Type == 'Track' && B.NetName == 'PHY_1V0' && B.enclosedByArea('U30_MDI_LAUNCH')")
  (constraint clearance (min 0.27mm)))
(rule "100R intra-pair skew"
  (condition "A.hasNetclass('LVDS_100R') || A.hasNetclass('MDI_100R')")
  (constraint skew (max 0.1mm) (within_diff_pairs)))
# The key post stands one pitch off its power header's line: the plastic clears
# by 0.07 mm, only the courtyards meet. The two 2x16 signal bodies of an edge
# stand end to end on the pitch (design.py). Named pairs only.
(rule "key post beside its power header"
  (condition "(A.Reference == 'MK*' && (B.Reference == 'J53' || B.Reference == 'J62' || B.Reference == 'J54' || B.Reference == 'J63' || B.Reference == 'J55' || B.Reference == 'J64' || B.Reference == 'J56' || B.Reference == 'J65' || B.Reference == 'J57' || B.Reference == 'J58')) || (B.Reference == 'MK*' && (A.Reference == 'J53' || A.Reference == 'J62' || A.Reference == 'J54' || A.Reference == 'J63' || A.Reference == 'J55' || A.Reference == 'J64' || A.Reference == 'J56' || A.Reference == 'J65' || A.Reference == 'J57' || A.Reference == 'J58'))")
  (constraint courtyard_clearance (min -1mm)))
(rule "signal bodies end to end"
  (condition "(A.Reference == 'J3A' && B.Reference == 'J3B') || (A.Reference == 'J3B' && B.Reference == 'J3A') || (A.Reference == 'J5A' && B.Reference == 'J5B') || (A.Reference == 'J5B' && B.Reference == 'J5A')")
  (constraint courtyard_clearance (min -1mm)))
