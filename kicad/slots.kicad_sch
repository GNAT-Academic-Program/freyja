	(text "VCCIO_1 selector" (at 575.31 919.48 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Jumper that picks the signal voltage of slots A-D: one shunt on J19 selects 3.3, 2.5 or 1.8 V. It powers FPGA\nbank 15 and the PIN V pin of those four slots. One position only; change it with the board unpowered." (at 575.31 924.56 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 1057.91) (end 198.12 1168.4) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "17f8441e-a690-4e6f-67c9-39af05bfb027"))
	(text "VCCIO_2 selector" (at 33.02 1061.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Jumper that picks the signal voltage of slots E-H (J20): 3.3, 2.5 or 1.8 V for FPGA bank 34 and those slots' PIN\nV pin." (at 33.02 1066.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 1057.91) (end 378.46 1113.79) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0e416672-fe31-1ed0-17a9-6db97338c3c1"))
	(text "mounting holes" (at 212.09 1061.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Four unplated M3 holes near the corners. They carry no net and are not assembled; they sit in the netlist so the\nboard and the schematic list the same parts." (at 212.09 1066.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
