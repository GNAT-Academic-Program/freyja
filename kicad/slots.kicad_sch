	(text "SLOTS  —  Ten keyed extension ports, branch fusing and level shifting  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 198.12 205.74) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "e51d392c-6a19-75a6-509f-837c590bf441"))
	(text "5V BUS 0 converter" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Lets the FPGA (3.3 V) talk to 5 V extensions on slot L. U9 shifts eight lines between 3.3 V and 5 V, all in one\ndirection at a time (BUS5V0_DIR). It stays off until the FPGA pulls BUS5V0_OE_N low; the pull-up keeps the bus\noff while the FPGA is still loading." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 41.91) (end 378.46 203.2) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "c3830997-d3bb-c67d-8564-e2157dbffc02"))
	(text "5V BUS 1 converter" (at 212.09 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Same as 5V BUS 0, for slot M: U10 shifts eight lines between the FPGA's 3.3 V and 5 V, direction BUS5V1_DIR, off\nuntil BUS5V1_OE_N goes low." (at 212.09 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 41.91) (end 557.53 142.24) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "cf1c78d9-c60a-a085-96ae-8aa4ef49fe1b"))
	(text "SHIELD HEADER AB" (at 392.43 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "First half of the right-edge 2x32 signal lattice: a 2x16 socket carrying the signals of slots A and B, twelve\nFPGA pins each (bank 15), with grounds between groups. Their voltage is whatever J19 selects. J3B continues the\nsame 2.54 mm lattice end to end." (at 392.43 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 570.23 41.91) (end 737.87 139.7) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "38652e32-6514-5d19-5d90-5f66fe743312"))
	(text "SHIELD HEADER CD" (at 572.77 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Second half of the right-edge lattice, end to end with J3A: the signals of slots C and D (bank 15, voltage set\nby J19)." (at 572.77 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 226.06) (end 198.12 323.85) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "8a07fc38-303f-8db1-9a91-4caa81284985"))
	(text "SHIELD HEADER EF" (at 33.02 229.87 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "First half of the left-edge 2x32 signal lattice: a 2x16 socket carrying the signals of slots E and F, twelve\nFPGA pins each (bank 34), voltage set by J20. J5B continues the lattice end to end." (at 33.02 234.95 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 226.06) (end 378.46 323.85) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "682ffd6a-456f-799c-2f36-7ffeb776969e"))
	(text "SHIELD HEADER GH" (at 212.09 229.87 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Second half of the left-edge lattice, end to end with J5A: the signals of slots G and H (bank 34, voltage set by\nJ20)." (at 212.09 234.95 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 226.06) (end 557.53 300.99) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "c9bc269a-3079-1ccc-4a9e-eebac552bc4e"))
	(text "SHIELD HEADER L" (at 392.43 229.87 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The signal socket of slot L (5V BUS 0): eight 5 V data lines from U9, with four grounds between them." (at 392.43 234.95 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 570.23 226.06) (end 737.87 300.99) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "835a6c97-4085-4e07-46de-269e5111f773"))
	(text "SHIELD HEADER M" (at 572.77 229.87 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The signal socket of slot M (5V BUS 1): eight 5 V data lines from U10, with four grounds between them." (at 572.77 234.95 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 342.9) (end 289.56 466.09) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "1a0f6b06-5832-e606-517d-14cdac0c8162"))
	(text "SLOT L branches" (at 33.02 346.71 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Power for whatever is plugged into slot L. The 1x7 power socket carries PIN V (3.3 V), 3.3 V, 5 V and AUX, each beside a ground, and each through its own resettable fuse, so a\nshort on one extension trips only that slot's fuse and the rest of the board keeps running. The long grounded pin in front of the socket is the key that stops an extension\ngoing in the wrong way, and a ground probe point." (at 33.02 351.79 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 300.99 342.9) (end 560.07 466.09) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "9a591acf-c8b6-76f3-c1e5-31a0670bc640"))
