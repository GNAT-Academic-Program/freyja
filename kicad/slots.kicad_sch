	(text "SLOTS  —  Ten keyed extension ports, branch fusing and level shifting  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 198.12 185.42) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "e51d392c-6a19-75a6-509f-837c590bf441"))
	(text "5V BUS 0 converter" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Lets the FPGA (3.3 V) talk to 5 V extensions on slot L. U9 shifts eight lines between 3.3 V and 5 V, all in one\ndirection at a time (BUS5V0_DIR). It stays off until the FPGA pulls BUS5V0_OE_N low; the pull-up keeps the bus\noff while the FPGA is still loading." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 41.91) (end 378.46 182.88) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "c3830997-d3bb-c67d-8564-e2157dbffc02"))
	(text "5V BUS 1 converter" (at 212.09 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Same as 5V BUS 0, for slot M: U10 shifts eight lines between the FPGA's 3.3 V and 5 V, direction BUS5V1_DIR, off\nuntil BUS5V1_OE_N goes low." (at 212.09 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 41.91) (end 557.53 180.34) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "d6e1510d-ef43-2874-fe53-b2094370378e"))
	(text "SHIELD HEADER ABCD" (at 392.43 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One long 2x32 socket on the right edge carrying the signals of slots A, B, C and D: twelve FPGA pins each (bank\n15), with grounds between groups. Their voltage is whatever J19 selects." (at 392.43 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 205.74) (end 198.12 344.17) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "f1204952-2da8-8f55-991a-a6d59dc34568"))
	(text "SHIELD HEADER EFGH" (at 33.02 209.55 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One long 2x32 socket on the left edge carrying the signals of slots E, F, G and H: twelve FPGA pins each (bank\n34), voltage set by J20." (at 33.02 214.63 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 205.74) (end 378.46 280.67) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "c9bc269a-3079-1ccc-4a9e-eebac552bc4e"))
	(text "SHIELD HEADER L" (at 212.09 209.55 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The signal socket of slot L (5V BUS 0): eight 5 V data lines from U9, with four grounds between them." (at 212.09 214.63 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 205.74) (end 557.53 280.67) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "835a6c97-4085-4e07-46de-269e5111f773"))
	(text "SHIELD HEADER M" (at 392.43 209.55 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The signal socket of slot M (5V BUS 1): eight 5 V data lines from U10, with four grounds between them." (at 392.43 214.63 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 363.22) (end 289.56 486.41) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "1a0f6b06-5832-e606-517d-14cdac0c8162"))
	(text "SLOT L branches" (at 33.02 367.03 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Power for whatever is plugged into slot L. The 1x7 power socket carries PIN V (3.3 V), 3.3 V, 5 V and AUX, each beside a ground, and each through its own resettable fuse, so a\nshort on one extension trips only that slot's fuse and the rest of the board keeps running. The long grounded pin in front of the socket is the key that stops an extension\ngoing in the wrong way, and a ground probe point." (at 33.02 372.11 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 300.99 363.22) (end 560.07 486.41) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "9a591acf-c8b6-76f3-c1e5-31a0670bc640"))
	(text "SLOT M branches" (at 303.53 367.03 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Power for whatever is plugged into slot M. The 1x7 power socket carries PIN V (3.3 V), 3.3 V, 5 V and AUX, each beside a ground, and each through its own resettable fuse, so a\nshort on one extension trips only that slot's fuse and the rest of the board keeps running. The long grounded pin in front of the socket is the key that stops an extension\ngoing in the wrong way, and a ground probe point." (at 303.53 372.11 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 506.73) (end 289.56 629.92) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0fbf56dd-2be5-1475-2198-8fee8ac9b60a"))
