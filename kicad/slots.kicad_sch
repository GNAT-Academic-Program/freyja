	(text "VCCIO_1 selector" (at 33.02 1082.04 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Jumper that picks the signal voltage of slots A-D: one shunt on J19 selects 3.3, 2.5 or 1.8 V. It powers FPGA\nbank 15 and the PIN V pin of those four slots. One position only; change it with the board unpowered." (at 33.02 1087.12 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 1078.23) (end 378.46 1188.72) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "17f8441e-a690-4e6f-67c9-39af05bfb027"))
	(text "VCCIO_2 selector" (at 212.09 1082.04 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Jumper that picks the signal voltage of slots E-H (J20): 3.3, 2.5 or 1.8 V for FPGA bank 34 and those slots' PIN\nV pin." (at 212.09 1087.12 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
