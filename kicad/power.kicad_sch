		(property "Value" "TPS25942ARVCR" (at 95.25 107.95 0) (effects (font (size 1.27 1.27))))
		(property "Footprint" "EasyEDA:QFN-20_L4.0-W3.0-P0.5-BL-EP" (at 95.25 107.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C181295" (at 95.25 107.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "USB input eFuse: TI TPS25942A: ramps USB power in gently, cuts off outside 3.7-10 V, limits current to about 3 A (the Type-C cable figure), blocks reverse current, retries by itself. Reports faults on EXT_FAULT; IMON gives 0.52 V per ampere as a probe point." (at 95.25 107.95 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(instances (project "odin" (path "/c44fb7fe-6133-ad34-68fd-fb66126197ef/d8079187-14d6-b109-30bb-e1c878749fb7" (reference "U26") (unit 1))))
	)
