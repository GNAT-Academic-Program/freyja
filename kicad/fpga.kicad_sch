	(rectangle (start 30.48 958.85) (end 411.48 1019.81) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "e2acc14a-aef5-016a-01b4-ae840f405db0"))
	(text "decap +1V0_MGT" (at 33.02 962.66 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Decoupling for +1V0_MGT (+1V0_MGT), which powers the unused but powered transceivers (MGTAVCC); the MGT supplies are UG482's, not in UG483 Table 2-2: one 100 nF per ball plus 4.7 uF. Placement rule: ref/decoupling.md." (at 33.02 967.74 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 1038.86) (end 477.52 1099.82) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "e256b3ac-e4bf-fc42-3443-01b6484a3d20"))
	(text "decap +1V2_MGT" (at 33.02 1042.67 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Decoupling for +1V2_MGT (+1V2_MGT), which powers the unused but powered transceivers (MGTAVTT); the MGT supplies are UG482's, not in UG483 Table 2-2: one 100 nF per ball plus 4.7 uF. Placement rule: ref/decoupling.md." (at 33.02 1047.75 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 488.95 1038.86) (end 656.59 1102.36) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "c754c9a2-dc78-2caf-5f12-51c186ff123b"))
	(text "decap VCCO group +1V8_IO" (at 491.49 1042.67 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Bulk capacitor shared by every FPGA I/O bank powered from +1V8_IO: UG483 Table 2-2 note 3 asks one 47 uF per\ngroup of up to four banks on one voltage. See ref/decoupling.md." (at 491.49 1047.75 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 1122.68) (end 398.78 1191.26) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "cf30ce7d-0c97-e249-9449-606ef4c0fc34"))
	(text "config straps (UG470)" (at 33.02 1126.49 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "How the FPGA loads its design at power-on. M[2:0] = 001 selects master SPI: the FPGA clocks its bitstream out of the W25Q256 flash (U6) by itself. The mode straps are 1 k, the most UG470 v1.17 Table 2-4 allows. PROGRAM_B and INIT_B are pulled up so the\nboard controller can restart configuration; PUDC_B is strapped high so the FPGA adds no pull-ups while it configures: every line that needs a level (PHY reset, SDRAM CS/CKE, MRAM and microSD CS, the 5 V bus OE, the PSRAM clock and data) has its own\nresistor, and nothing fights it. DONE lights D1 through Q4 once a design is running." (at 33.02 1131.57 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 410.21 1122.68) (end 577.85 1188.72) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "d651e466-9fa4-5f3c-cb9b-c0d9d42a602c"))
	(text "GTP calibration" (at 412.75 1126.49 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The XC7A100T has two quads of multi-gigabit transceivers (GTP). Rev A uses none of them, but UG482 Tables 5-5\nand 5-6 still want their supplies powered, their receive inputs grounded and one 100 ohm 1 % calibration\nresistor per quad to MGTAVTT. These two resistors are that." (at 412.75 1131.57 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 590.55 1122.68) (end 758.19 1188.72) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4d2c21b1-b406-4315-b8ae-8127a6f171de"))
	(text "X4 system clock" (at 593.09 1126.49 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The FPGA's own clock. X4 runs at 50 MHz from power-on and enters bank 14 on a clock-capable (MRCC) ball, so it\ncan feed an MMCM and make any frequency the design needs. Without it nothing in the fabric would run until a\nnetwork link came up." (at 593.09 1131.57 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 1210.31) (end 198.12 1276.35) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "1d468920-2a76-26f1-2fd4-2faa08476750"))
	(text "config flash" (at 33.02 1214.12 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The FPGA's non-volatile memory. At power-on the FPGA reads its design (bitstream) from this 32 MB flash by\nitself (master SPI, set by the mode straps). The board controller can rewrite it through the series resistors on\nthe Board Controller sheet, and spare space can hold user data or software for a soft CPU." (at 33.02 1219.2 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
