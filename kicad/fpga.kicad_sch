	(text "FPGA  —  FPGA, decoupling and configuration straps  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 646.43 521.97) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "be97a8d6-7bff-b223-123a-9622734b40d2"))
	(text "U1  FPGA" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The FPGA is the board: every user design (a NEORV32 RISC-V core, a video pipeline, a protocol bridge) runs here. Its six user I/O banks are dedicated by job: bank 13 at 1.8 V carries the four PSRAMs and the two 5 V bus translators, bank 14 the configuration flash, the board-controller sideband, the 50 MHz clock, the SDRAM address bus, the MRAM and the microSD socket, banks 15 and 34 the direct extension slots A-D and E-H at\na jumper-selected voltage, bank 16 the network at 2.5 V, bank 35 the HDMI output, the SDRAM data bus and the PHY reset/interrupt. Ball-by-ball list: ref/ballmap.md; constraints: ref/freya.xdc." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 542.29) (end 543.56 603.25) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "48f5f4b5-d5c9-b78a-0e19-36483f1cacd0"))
	(text "decap VCCINT" (at 33.02 546.1 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Decoupling for VCCINT (+1V0), which powers the FPGA core logic; quantities from UG483 Table 2-2, row FGG676 / XC7A100T. Placement rule: ref/decoupling.md." (at 33.02 551.18 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 554.99 542.29) (end 722.63 605.79) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0a9b6c73-8753-b5aa-8b8e-12d474ad7aa4"))
	(text "decap VCCBRAM" (at 557.53 546.1 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Decoupling for VCCBRAM (+1V0), which powers the FPGA block RAM; quantities from UG483 Table 2-2, row FGG676 /\nXC7A100T. Placement rule: ref/decoupling.md." (at 557.53 551.18 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 626.11) (end 345.44 685.8) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "9f418040-21f3-dfeb-5457-e9b942ea527d"))
	(text "decap VCCAUX" (at 33.02 629.92 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
