	(gr_arc (start 150.0 127.0) (mid 149.12132034 129.12132034) (end 147.0 130.0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_arc (start 33.0 130.0) (mid 30.87867966 129.12132034) (end 30.0 127.0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
	(gr_arc (start 30.0 33.0) (mid 30.87867966 30.87867966) (end 33.0 30.0) (stroke (width 0.1) (type default)) (layer "Edge.Cuts"))
