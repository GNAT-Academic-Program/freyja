	)
	(text "SUPERVISOR  —  Board controller: RP2350B, USB-C, startup memory and FPGA control  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 510.54 264.16) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4d8336bb-6638-51c2-50d2-998895712517"))
	(text "U7  board controller" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The board controller, a Raspberry Pi RP2350B microcontroller that is always on. It is what the USB cable talks to: it loads designs into the FPGA over JTAG or writes them to the FPGA's flash, turns the supplies on in order and watches them, asks a USB-PD charger for 9 V, enables extension power, and gives the FPGA a debug and\nUART link. One 100 nF capacitor per supply pin (RP-008280 section 2.2.1)." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 284.48) (end 213.36 346.71) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "52227247-a2b3-7725-f609-ddff582e6331"))
	(text "U7 core regulator (RP-008280 s2.1)" (at 33.02 288.29 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Parts for the RP2350's built-in switching regulator, which makes its 1.1 V core supply (+1V1) from +3V3. Values and the\ninductor are the ones Raspberry Pi specifies in their hardware design guide (RP-008280 section 2.1)." (at 33.02 293.37 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 224.79 284.48) (end 392.43 349.25) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "463ea665-a2bc-fe5d-243e-8bdd208909fd"))
	(text "crystal (RP-008280 s4)" (at 227.33 288.29 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The board controller's 12 MHz clock: the exact crystal, load capacitors and 1 k drive-limiting resistor\nRaspberry Pi specifies (RP-008280 section 4)." (at 227.33 293.37 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 405.13 284.48) (end 572.77 346.71) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "b0e64298-09cd-6cc0-4158-65a4b2a74290"))
	(text "RUN" (at 407.67 288.29 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The board controller's reset input. The pull-up keeps it running; the capacitor holds it in reset briefly at\npower-on until +3V3 is stable." (at 407.67 293.37 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 369.57) (end 198.12 497.84) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "5680be02-301b-a348-7808-12d8bf4b8920"))
	(text "board controller startup memory" (at 33.02 373.38 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The board controller's own 4 MB flash, holding its firmware. Separate from the FPGA's flash." (at 33.02 378.46 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 369.57) (end 378.46 472.44) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0ad627f7-b26b-c350-95d8-6ce95426fe06"))
	(text "USB-C" (at 212.09 373.38 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The main connector: power in, and the USB link to your computer for programming and talking to the board." (at 212.09 378.46 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 369.57) (end 557.53 482.6) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "6d819b6e-ab6a-0547-06b1-098cbd3a9e95"))
	(text "USB protection" (at 392.43 373.38 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Clamps for static discharge and voltage spikes on the USB connector: D6 on the data and CC lines, D7 on the\npower line (VBUS)." (at 392.43 378.46 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 518.16) (end 223.52 648.97) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "6d2cf5a4-58bd-e6fb-48c0-83f6d93483fd"))
	(text "USB-PD sink" (at 33.02 521.97 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Negotiates the supply voltage with a USB-PD charger. Out of the box it asks for 5 V: CFG1 is pulled up to the chip's own 3.3 V\nand CFG2/CFG3 are grounded, so the only other request the pins can form is 9 V, which the board controller selects by turning Q3\non (PD_REQ_9V). A dead or resetting controller leaves it at 5 V. PD_PG tells the controller whether the charger agreed." (at 33.02 527.05 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 234.95 518.16) (end 402.59 584.2) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "33e4d7a4-0be4-5233-848d-e64637d19776"))
	(text "BOOTSEL" (at 237.49 521.97 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Hold CTRL BOOT while plugging in USB to put the board controller in its built-in USB bootloader, for installing\nor recovering its firmware. The 1 k resistor lets the button win without fighting the chip. The 10 k pull-up is\nnot fitted, as in Raspberry Pi's design." (at 237.49 527.05 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 415.29 518.16) (end 582.93 590.55) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "5b7da61a-5e86-4511-82c9-62453b58f39a"))
	(text "board controller SWD" (at 417.83 521.97 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Debug connector for the board controller's own processor (SWD): for developing its firmware with a debug probe.\nNot for the FPGA." (at 417.83 527.05 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 668.02) (end 674.37 728.98) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "9ef44636-e348-b650-da9a-cd524c21f9d5"))
	(text "series resistors to FPGA" (at 33.02 671.83 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor on every wire between the board controller and the FPGA: JTAG, the configuration pins, the FPGA flash bus, the debug sideband and the UART. They limit current if both sides ever drive the same wire at once, and damp ringing." (at 33.02 676.91 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 749.3) (end 198.12 902.97) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "6a85a067-7ffb-c6b6-0408-bf1bead4f477"))
	(text "JTAG owner selection" (at 33.02 753.11 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Decides who programs the FPGA over JTAG. Normally (J52 open) the board controller does, through the U20 switch.\nFit a jumper on J52 and U20 disconnects the board controller completely, so an external programmer plugged into\nJ2 has the FPGA to itself. A jumper, not software, so it works even when the board controller is broken." (at 33.02 758.19 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 749.3) (end 378.46 816.61) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "206da88b-f772-9b94-a20a-588a83237fd6"))
	(text "manual JTAG header" (at 212.09 753.11 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Standard 2x5 JTAG header for an external FPGA programmer (Xilinx/AMD cable or similar). Fit J52 first." (at 212.09 758.19 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 749.3) (end 636.27 812.8) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "8381b297-3c27-042e-840d-9f127d2415a0"))
	(text "board status LEDs" (at 392.43 753.11 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Three green LEDs on board controller GPIO35-37, lit by driving the pin low: CTRL HB blinks while the board controller firmware is alive; USER 1 and USER 2 are for\nsoftware. Each has a 1 k current-limiting resistor from +3V3. Rules: ref/status-leds.md." (at 392.43 758.19 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 923.29) (end 198.12 985.52) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "afe02e32-cf04-2023-665e-8fbc07e1c11b"))
	(text "U7  USB series resistors" (at 33.02 927.1 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Two 27 ohm resistors in the USB data lines, right at the board controller, as Raspberry Pi's hardware design\nguide (section 5.1) asks. The ESD clamp D6 stays at the connector." (at 33.02 932.18 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(symbol (lib_id "MCU_RaspberryPi:RP2350B") (at 102.87 137.16 0) (unit 1)
