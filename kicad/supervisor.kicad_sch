		(property "Footprint" "EasyEDA:QFN-80_L10.0-W10.0-P0.40-TL-EP3.4" (at 102.87 199.39 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C42415655" (at 102.87 199.39 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "board controller: Raspberry Pi RP2350B microcontroller (two Cortex-M33 cores, 150 MHz): USB, FPGA programming, power sequencing and monitoring." (at 102.87 199.39 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(instances (project "odin" (path "/c44fb7fe-6133-ad34-68fd-fb66126197ef/3e2df089-f023-0194-2f85-195f6ca76ec6" (reference "U7") (unit 1))))
