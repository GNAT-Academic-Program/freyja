	(text "VIDEO  —  Video: HDMI out from bank 35 (TMDS_33) through a TPD12S016  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 255.27 210.82) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "10d7455e-10af-fb02-55da-1b41e24ec03e"))
	(text "HDMI out" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "A video output for monitors and TVs. Bank 35 drives the four HDMI lanes directly as TMDS_33 pairs, the standard Artix-7 way: the monitor's own 50 ohm\npull-ups to 3.3 V terminate them, so the board adds none. 720p at 60 Hz fits comfortably; 1080p at 60 Hz does not. U31 sits at the connector: it clamps\nESD on every line, shifts the DDC (EDID) and CEC lines between 3.3 V and the cable's 5 V, buffers hot plug, and feeds the cable's 5 V pin through a 55\nmA current limit (TI SLLSE96F, Figure 18). Its two enables are pulled on, so EDID works under any design. The unused utility pin goes to ground through\n75 ohm, as TI's layout example asks." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(symbol (lib_id "odin:TPD12S016PW") (at 95.25 101.6 0) (unit 1)
		(exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no)
		(uuid "23554920-9646-c571-82a1-486fd1b006dd")
		(property "Reference" "U31" (at 95.25 82.55 0) (effects (font (size 1.27 1.27))))
		(property "Value" "TPD12S016PWR" (at 95.25 120.65 0) (effects (font (size 1.27 1.27))))
		(property "Footprint" "Package_SO:TSSOP-24_4.4x7.8mm_P0.65mm" (at 95.25 120.65 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C201665" (at 95.25 120.65 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Description" "HDMI protection and level shifter: TI TPD12S016: ESD clamps on the four HDMI pairs, DDC and CEC level shifting from 3.3 V to 5 V, hot plug buffer and a 55 mA current-limited 5 V for the cable." (at 95.25 120.65 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(instances (project "odin" (path "/c44fb7fe-6133-ad34-68fd-fb66126197ef/7796611e-e9da-f6a6-e759-e95cdfaecfe5" (reference "U31") (unit 1))))
	)
