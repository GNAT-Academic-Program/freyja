	(text "MEMORY  —  PSRAM x4 (independent buses, 1.8 V), SDRAM and configuration flash  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 198.12 172.72) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4ae04aab-5386-d64e-4176-eb6aa4baef08"))
	(text "PSRAM0" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 0: 8 MB of fast RAM for the FPGA design, on its own four-bit (QSPI) bus to bank 13 at 1.8 V.\nThe four chips are independent, so a design can use them in parallel. Notes: ref/psram.md." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 41.91) (end 378.46 170.18) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4f0c068e-e117-7c97-36d4-36565b4ad527"))
	(text "PSRAM1" (at 212.09 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 1: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 212.09 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 193.04) (end 198.12 321.31) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "649fd6db-44e3-508b-c954-221962d2e897"))
	(text "PSRAM2" (at 33.02 196.85 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 2: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 33.02 201.93 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 193.04) (end 378.46 321.31) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "85466ef6-5687-4797-7828-06fdd822a0da"))
	(text "PSRAM3" (at 212.09 196.85 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 3: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 212.09 201.93 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 340.36) (end 198.12 461.01) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "b074a18b-26dd-e370-f0c9-f2ebbe513586"))
	(text "config flash" (at 33.02 344.17 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The FPGA's non-volatile memory. At power-on the FPGA reads its design (bitstream) from this 32 MB flash by\nitself (master SPI, set by the mode straps). The board controller can rewrite it through the series resistors on\nthe Board Controller sheet, and spare space can hold user data or software for a soft CPU." (at 33.02 349.25 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 340.36) (end 425.45 403.86) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "b5025c23-9b56-0118-633f-29d6b68f42c4"))
	(text "PSRAM0 series termination" (at 212.09 344.17 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM0 line, placed next to the FPGA: they soften the fast signal edges so they do not ring along the trace. Values can\nbe tuned after measurement (ref/psram.md)." (at 212.09 349.25 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 481.33) (end 246.38 542.29) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "b0eac2f5-0410-e1a3-2a53-9a5778c3ffb6"))
	(text "PSRAM1 series termination" (at 33.02 485.14 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM1 line, next to the FPGA, to damp ringing." (at 33.02 490.22 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 257.81 481.33) (end 473.71 542.29) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "9e23ea8c-6b08-4bc8-e607-c7c48129d61f"))
	(text "PSRAM2 series termination" (at 260.35 485.14 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM2 line, next to the FPGA, to damp ringing." (at 260.35 490.22 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 561.34) (end 246.38 622.3) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "96663b0d-d848-f839-1239-2687f1040fd5"))
	(text "PSRAM3 series termination" (at 33.02 565.15 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM3 line, next to the FPGA, to damp ringing." (at 33.02 570.23 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 642.62) (end 411.48 821.69) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "3f4df3b7-0320-797a-cacb-ceab7b0540cb"))
	(text "SDRAM" (at 33.02 646.43 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "A 32 MB SDR SDRAM (Winbond W9825G6KH-6, 16 bits wide, up to 166 MHz) for designs that outgrow the PSRAMs: a framebuffer, a soft CPU's main memory, a capture buffer. Its data and control lines come from bank 35 and its address lines from bank 14, both at 3.3 V.\nOne 100 nF per VDD/VDDQ pin pair (seven, datasheet pins 1, 14, 27 and 3, 9, 43, 49) and a 10 uF bulk; a 22 ohm series resistor at the FPGA damps the clock; CS is pulled up and CKE pulled down so the chip stays deselected and in power-down until a design drives\nthem." (at 33.02 651.51 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
