	(text "MEMORY  —  PSRAM x4 (independent buses, 1.8 V), SDRAM, MRAM, microSD and configuration flash  —  HW 0.1.0-proto.1" (at 40 20 0) (effects (font (size 4 4) (thickness 0.6)) (justify left)))
	(rectangle (start 30.48 41.91) (end 198.12 172.72) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4ae04aab-5386-d64e-4176-eb6aa4baef08"))
	(text "PSRAM0" (at 33.02 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 0: 8 MB of fast RAM for the FPGA design, on its own four-bit (QSPI) bus to bank 13 at 1.8 V.\nThe four chips are independent, so a design can use them in parallel. Notes: ref/psram.md." (at 33.02 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 41.91) (end 378.46 170.18) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "4f0c068e-e117-7c97-36d4-36565b4ad527"))
	(text "PSRAM1" (at 212.09 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 1: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 212.09 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 41.91) (end 557.53 170.18) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "649fd6db-44e3-508b-c954-221962d2e897"))
	(text "PSRAM2" (at 392.43 45.72 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 2: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 392.43 50.8 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 193.04) (end 198.12 321.31) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "85466ef6-5687-4797-7828-06fdd822a0da"))
	(text "PSRAM3" (at 33.02 196.85 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Working-memory chip 3: 8 MB of RAM on its own QSPI bus to bank 13, at 1.8 V." (at 33.02 201.93 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 193.04) (end 378.46 313.69) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "b074a18b-26dd-e370-f0c9-f2ebbe513586"))
	(text "config flash" (at 212.09 196.85 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The FPGA's non-volatile memory. At power-on the FPGA reads its design (bitstream) from this 32 MB flash by\nitself (master SPI, set by the mode straps). The board controller can rewrite it through the series resistors on\nthe Board Controller sheet, and spare space can hold user data or software for a soft CPU." (at 212.09 201.93 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 193.04) (end 605.79 255.27) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "6d147cfd-1401-a47b-e378-6ea9b39d2499"))
	(text "U1 PSRAM0 series termination" (at 392.43 196.85 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM0 line, placed next to the FPGA: they soften the fast signal edges so they do not ring along the trace. Values can\nbe tuned after measurement (ref/psram.md)." (at 392.43 201.93 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 340.36) (end 246.38 401.32) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "7b07c704-0821-3b85-685a-6384934f58be"))
	(text "U1 PSRAM1 series termination" (at 33.02 344.17 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM1 line, next to the FPGA, to damp ringing." (at 33.02 349.25 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 257.81 340.36) (end 473.71 401.32) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0b86711a-6841-84e0-ded7-e3ae48aec7a9"))
	(text "U1 PSRAM2 series termination" (at 260.35 344.17 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM2 line, next to the FPGA, to damp ringing." (at 260.35 349.25 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 421.64) (end 246.38 482.6) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "6fe3ef85-b173-c11d-496c-ba23f45933f8"))
	(text "U1 PSRAM3 series termination" (at 33.02 425.45 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "One 33 ohm resistor per PSRAM3 line, next to the FPGA, to damp ringing." (at 33.02 430.53 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 257.81 421.64) (end 605.79 600.71) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "3f4df3b7-0320-797a-cacb-ceab7b0540cb"))
	(text "SDRAM" (at 260.35 425.45 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "A 32 MB SDR SDRAM (Winbond W9825G6KH-6, 16 bits wide, up to 166 MHz) for designs that outgrow the PSRAMs: a framebuffer, a soft CPU's main memory, a capture buffer. Its data and control lines come from bank 35 and its address lines from\nbank 14, both at 3.3 V. One 100 nF per VDD/VDDQ pin pair (seven, datasheet pins 1, 14, 27 and 3, 9, 43, 49) and a 10 uF bulk; a 22 ohm series resistor at the FPGA damps the clock; CS is pulled up and CKE pulled down so the chip stays\ndeselected and in power-down until a design drives them." (at 260.35 430.53 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 619.76) (end 198.12 683.26) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "49aa2c57-79aa-1f4c-8bcb-e5d944b89286"))
	(text "U1 SDRAM clock source" (at 33.02 623.57 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "The 22 ohm resistor in the SDRAM clock line. It sits at the FPGA ball that drives the clock, so it damps the\nedge at its source; it is in U1's island, not the SDRAM's (findings 44)." (at 33.02 628.65 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 209.55 619.76) (end 378.46 740.41) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "0b5dfb9f-a4eb-9c7e-7b89-64f62241dd1f"))
	(text "MRAM" (at 212.09 623.57 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "A 128 KB non-volatile SPI memory (Everspin MR25H10CDF) that keeps its contents without power and has no write\nwear: settings, logs, a boot menu, a save file. CS is pulled up so the chip stays deselected while power comes\nup (datasheet section 4); WP and HOLD are pulled up and not connected to the FPGA, so writes are allowed and\ntransfers never pause. The exposed pad is ground only, with two vias under it. Four bank 14 lines at 3.3 V." (at 212.09 628.65 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 389.89 619.76) (end 638.81 763.27) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "fd7aaa6c-0467-416d-c7e7-10e9a4e61137"))
	(text "microSD socket" (at 392.43 623.57 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "A push-push microSD socket (Hroparts TF-01A) wired for SPI mode: chip select on DAT3, data in on CMD, data out on DAT0, clock on CLK, five bank 14 lines at 3.3 V\nincluding the card-detect switch. The 10k pull-ups hold CS, the two data lines and the two unused DAT lines high, as the SD specification asks for SPI mode; the 100 nF\nand 10 uF feed the card's supply at the socket; the shell is grounded. Cheap removable storage for a soft CPU: a filesystem, images to load into the PSRAMs, logs." (at 392.43 628.65 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 783.59) (end 246.38 849.63) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "aae6a8e3-9f0d-a641-e6c9-2b9ec7884b6d"))
	(text "PSRAM0 power-up state" (at 33.02 787.4 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Six 10k resistors at the PSRAM0 pins: CE# pulled up to its own supply, clock and the four data lines pulled down. The chip requires these levels\nfrom the first moment of its supply ramp until 150 us after it, and an unconfigured FPGA leaves its pins floating, so resistors, not the FPGA,\nguarantee them (APS6404L section 8, findings 39)." (at 33.02 792.48 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 257.81 783.59) (end 473.71 844.55) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "a95b38b7-bca7-769a-7545-f581f7399b66"))
	(text "PSRAM1 power-up state" (at 260.35 787.4 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Six 10k resistors at the PSRAM1 pins: CE# up, clock and data down, from power-up (APS6404L section 8)." (at 260.35 792.48 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 30.48 869.95) (end 246.38 929.64) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "aaf05819-35c4-088e-be8c-5d03e208fe0e"))
	(text "PSRAM2 power-up state" (at 33.02 873.76 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Six 10k resistors at the PSRAM2 pins: CE# up, clock and data down, from power-up (APS6404L section 8)." (at 33.02 878.84 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
	(rectangle (start 257.81 869.95) (end 473.71 929.64) (stroke (width 0.15) (type dash)) (fill (type none)) (uuid "a18d09be-bf01-5479-938d-4192ba8d7b50"))
	(text "PSRAM3 power-up state" (at 260.35 873.76 0) (effects (font (size 2.2 2.2) (thickness 0.3)) (justify left)))
	(text "Six 10k resistors at the PSRAM3 pins: CE# up, clock and data down, from power-up (APS6404L section 8)." (at 260.35 878.84 0) (effects (font (size 1.5 1.5) (italic yes)) (justify left top)))
